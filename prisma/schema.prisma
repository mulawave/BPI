model UserEarning {
  id             String         @id
  userId         String
  channelId      String
  amount         Decimal        @db.Decimal(10, 2)
  type           String
  isPaid         Boolean        @default(false)
  createdAt      DateTime       @default(now())
  YoutubeChannel YoutubeChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  User           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([isPaid])
  @@index([type])
  @@index([userId])
}

model UserFeatureProgress {
  id               String           @id
  userId           String
  featureId        String
  currentProgress  Json?
  progressPercent  Float            @default(0)
  isQualified      Boolean          @default(false)
  qualifiedAt      DateTime?
  lastCalculatedAt DateTime         @default(now())
  milestones       Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  CommunityFeature CommunityFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  User             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, featureId])
  @@index([featureId])
  @@index([isQualified])
  @@index([userId])
}

model UserThirdPartyLink {
  id                 String             @id
  userId             String
  platformId         String
  username           String?
  profileUrl         String?
  referralLink       String?
  isVerified         Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime
  ThirdPartyPlatform ThirdPartyPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  User               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platformId])
  @@index([platformId])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WithdrawalHistory {
  id          String   @id
  userId      String
  description String
  amount      Float
  currency    String
  status      String
  date        DateTime @default(now())
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model YoutubeChannel {
  id                  String                @id
  userId              String
  channelName         String?
  channelUrl          String?
  status              String                @default("DRAFT")
  subscribers         Int?
  createdAt           DateTime              @default(now())
  channelLink         String?
  channelLogo         String?
  isVerified          Boolean               @default(false)
  updatedAt           DateTime
  verificationCode    String?               @unique
  ChannelSubscription ChannelSubscription[]
  UserEarning         UserEarning[]
  User                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isVerified])
  @@index([status])
  @@index([userId])
}

model YoutubePlan {
  id              String            @id
  name            String            @unique
  amount          Decimal           @db.Decimal(10, 2)
  vat             Decimal           @db.Decimal(10, 2)
  totalSub        Int
  description     String?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  YoutubeProvider YoutubeProvider[]

  @@index([isActive])
}

model YoutubeProvider {
  id            String      @id
  userId        String      @unique
  youtubePlanId String
  balance       Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime
  User          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  YoutubePlan   YoutubePlan @relation(fields: [youtubePlanId], references: [id])

  @@index([userId])
  @@index([youtubePlanId])
}

model PaymentGatewayConfig {
  id                   String   @id
  gatewayName          String   @unique
  displayName          String
  provider             String
  isActive             Boolean  @default(false)
  publicKey            String?
  secretKey            String?
  merchantId           String?
  webhookUrl           String?
  callbackUrl          String?
  supportedMethods     String[] @default([])
  currency             String   @default("NGN")
  fees                 Json?
  limits               Json?
  logo                 String?
  description          String?
  displayOrder         Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime
  apiProvider          String?
  bankAccount          String?
  bankAccountName      String?
  bankName             String?
  cryptoPublicKey      String?
  cryptoSecretKey      String?
  cryptoDepositAddress String?
  cryptoNetwork        String?
  currentPriceNgn      Float?
  currentPriceUsd      Float?
  homePageUrl          String?
  merchantKey          String?
  tokenContractAddress String?
  tokenName            String?
  tokenSymbol          String?
  tokenomicsUrl        String?

  @@index([isActive, displayOrder])
}

model AuditLog {
  id           String   @id
  userId       String
  action       String
  entity       String
  entityId     String?
  changes      Json?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  status       String   @default("success")
  errorMessage String?
  createdAt    DateTime @default(now())
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

model PendingPayment {
  id               String    @id
  userId           String
  transactionType  String
  amount           Float
  currency         String    @default("NGN")
  paymentMethod    String
  gatewayReference String?
  status           String    @default("pending")
  metadata         Json?
  proofOfPayment   String?
  reviewedBy       String?
  reviewedAt       DateTime?
  reviewNotes      String?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime
  Reviewer         User?     @relation("PaymentReviewer", fields: [reviewedBy], references: [id])
  User             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model AdminNotificationSettings {
  id               String   @id
  notificationType String   @unique
  enabled          Boolean  @default(true)
  emailEnabled     Boolean  @default(true)
  smsEnabled       Boolean  @default(false)
  pushEnabled      Boolean  @default(true)
  recipients       String[] @default([])
  template         String?
  thresholds       Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime
}

model Country {
  id              Int       @id
  name            String
  dialCode        Int?      @map("dial_code")
  code            String?
  createdDatetime DateTime? @map("created_datetime")
  users           User[]
  states          State[]

  @@map("countries")
}

model State {
  id        Int       @id
  countryId Int       @map("country_id")
  name      String
  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @map("updated_at")
  users     User[]
  cities    City[]
  country   Country   @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@index([countryId])
  @@map("states")
}

model City {
  id      Int    @id
  name    String
  stateId Int    @map("state_id")
  users   User[]
  state   State  @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@index([stateId])
  @@map("cities")
}

model Bank {
  id              Int              @id @default(autoincrement())
  bankName        String           @map("bank_name")
  bankCode        String           @map("bank_code")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  userBankRecords UserBankRecord[]

  @@map("nigerian_banks")
}

model UserBankRecord {
  id            Int      @id @default(autoincrement())
  userId        String   @map("user_id")
  bankId        Int?     @map("bank_id")
  bankName      String?  @map("bank_name")
  accountName   String   @map("account_name")
  accountNumber String   @map("account_number")
  bvn           String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  isDefault     Boolean  @default(false) @map("is_default")
  bank          Bank?    @relation(fields: [bankId], references: [id])
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bankId])
  @@index([userId, isDefault])
  @@map("bank_records")
}

model CspSupportRequest {
  id                 String    @id @default(cuid())
  userId             String
  category           String    // "national" | "global"
  amount             Int
  requestedAmount    Int?      // original user-requested amount before 20% markup
  purpose            String
  notes              String?
  status             String    @default("pending") // pending | approved | rejected | broadcasting | ready_for_release | released | closed
  thresholdAmount    Int
  raisedAmount       Int       @default(0)
  contributorsCount  Int       @default(0)
  broadcastExpiresAt DateTime?
  approvedBy         String?
  approvedAt         DateTime?
  releasedAt         DateTime?
  rejectionReason    String?
  cooldownMonths     Int?      // set at approval: 6 | 12 | 24 | 36
  cooldownEndsAt     DateTime? // computed at release time
  countryCode        String?   // ISO country code for national geo-scoping
  isAdminDefault     Boolean   @default(false) // Admin-created base requests
  isActive           Boolean   @default(true)  // Admin can turn off default requests
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  User               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  Contributions      CspContribution[]
  Extensions         CspBroadcastExtension[]
  WaitReductions     CspWaitReductionLog[]

  @@index([userId, status])
  @@index([status, broadcastExpiresAt])
  @@index([isAdminDefault, isActive])
  @@index([countryCode, status])
}

/// Tracks monthly contributions made after a CSP release, used to reduce the cooldown wait period.
/// ₦10,000 contributed in a single calendar month = 1 month deducted from cooldownEndsAt.
model CspWaitReductionLog {
  id              String   @id @default(cuid())
  userId          String
  requestId       String   // The released request that triggered the cooldown
  monthKey        String   // "YYYY-MM" — the calendar month this reduction covers
  amountContrib   Int      @default(0) // cumulative contributions in this month (capped at 10000 for reduction)
  monthReduced    Boolean  @default(false) // whether this month's threshold was hit and reduction applied
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  Request         CspSupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  User            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, requestId, monthKey])
  @@index([userId, requestId])
}

/// Tracks CSP country activation state. A country becomes CSP-active when it reaches the activation threshold.
model CspCountry {
  id                    String    @id @default(cuid())
  countryCode           String    @unique // ISO alpha-2 code e.g. "NG"
  countryName           String
  isNationalActive      Boolean   @default(false)
  isGlobalActive        Boolean   @default(false)
  regularActivationCount Int      @default(0) // running count toward national activation
  activationThreshold   Int       @default(10000) // configurable
  activatedAt           DateTime?
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([isNationalActive])
}

model CspContribution {
  id            String   @id @default(cuid())
  requestId     String
  contributorId String
  amount        Int
  walletType    String   // community | cash
  createdAt     DateTime @default(now())
  Request       CspSupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  Contributor   User              @relation(fields: [contributorId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([contributorId])
}

model CspBroadcastExtension {
  id           String   @id @default(cuid())
  requestId    String
  type         String   // paid | referrals
  value        Int?
  hoursGranted Int
  createdAt    DateTime @default(now())
  Request      CspSupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model FarmPlot {
  id              String   @id
  userId          String
  plotName        String
  cropType        String
  plotSize        Float    // in hectares
  investmentAmount Float
  stage           String   @default("seeded") // seeded | growing | harvesting | completed
  progress        Int      @default(0)
  daysRemaining   Int
  estimatedYield  Float
  estimatedRevenue Float
  actualYield     Float?
  actualRevenue   Float?
  imageUrl        String?
  startedAt       DateTime @default(now())
  harvestDate     DateTime?
  completedAt     DateTime?
  status          String   @default("active") // active | harvested | failed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  User            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  Activities      FarmActivity[]

  @@index([userId])
  @@index([status])
}

model FarmActivity {
  id          String   @id
  plotId      String
  activityType String  // watering | fertilizing | harvesting | maintenance
  description String
  imageUrl    String?
  createdAt   DateTime @default(now())
  Plot        FarmPlot @relation(fields: [plotId], references: [id], onDelete: Cascade)

  @@index([plotId])
}

model CropType {
  id              String   @id
  name            String
  category        String   // vegetables | grains | fruits | livestock
  description     String
  growthDuration  Int      // days
  minInvestment   Float
  maxInvestment   Float
  yieldPerHectare Float
  pricePerKg      Float
  imageUrl        String?
  isActive        Boolean  @default(true)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([name])
}

model ImpersonationToken {
  id           String   @id
  token        String   @unique
  adminId      String
  targetUserId String
  expiresAt    DateTime
  used         Boolean  @default(false)
  usedAt       DateTime?
  createdAt    DateTime @default(now())
  Admin        User     @relation("ImpersonationTokenAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  TargetUser   User     @relation("ImpersonationTokenTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([adminId])
  @@index([targetUserId])
}

// ============================================
// REVENUE TRACKING & ALLOCATION SYSTEM
// ============================================

enum RevenueSource {
  COMMUNITY_SUPPORT      // CSP payments
  MEMBERSHIP_REGISTRATION // New member payments
  MEMBERSHIP_RENEWAL     // Membership renewals
  STORE_PURCHASE         // BPI Store orders
  WITHDRAWAL_FEE         // Withdrawal processing fees
  YOUTUBE_SUBSCRIPTION   // YouTube plan subscriptions
  THIRD_PARTY_SERVICES   // Third-party integrations
  PALLIATIVE_PROGRAM     // Palliative related
  LEADERSHIP_POOL_FEE            // Leadership pool entries
  TRAINING_CENTER                // Training center fees
  ELITE_CLUB_OPS                 // Elite Club operations fee (5% of monthly investment allocation)
  ELITE_CLUB_INVESTMENT_PROFIT   // BPI share of Elite Club investment profits (optional, max 5%)
  OTHER                          // Other revenue streams
}

enum AllocationStatus {
  PENDING       // Revenue recorded, allocation not yet done
  ALLOCATED     // Split into Company/Executive/Pools
  DISTRIBUTED   // Executive shares distributed to wallets
  COMPLETED     // All processing done
  FAILED        // Allocation/distribution failed
}

enum PoolType {
  LEADERSHIP    // 4% of total revenue
  STATE         // 4% of total revenue
  DIRECTORS     // 4% of total revenue
  TECHNOLOGY    // 4% of total revenue
  INVESTORS     // 4% of total revenue
}

enum DistributionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DistributionFrequency {
  MANUAL      // Distribute on-demand only
  MONTHLY     // Distribute monthly (State Pool)
  QUARTERLY   // Distribute quarterly
  BI_ANNUAL   // Distribute every 6 months (Investors Pool)
  ANNUAL      // Distribute annually (Directors Pool)
}

enum WalletTransactionType {
  DISTRIBUTION
  WITHDRAWAL
  ADJUSTMENT
  BONUS
}

model RevenueTransaction {
  id              String         @id @default(cuid())
  source          RevenueSource
  // Optional extended source key for management-configurable future sources.
  // Example: source=OTHER, sourceKey="CERTIFICATION_PROGRAM".
  sourceKey        String?
  amount          Decimal        @db.Decimal(18, 2)
  currency        String         @default("NGN")
  description     String?
  sourceId        String?        // Original transaction/payment ID (idempotency key scoped by source)
  userId          String?        // User who generated the revenue (if applicable)
  // Optional dimensions for reporting (product/geography/program/time). Caller is responsible for populating.
  programType     String?
  productId       String?
  orderId         String?
  packageId       String?
  country         String?
  state           String?
  region          String?
  tokenSymbol     String?
  metadata        Json?
  profitPoolConfigVersionId String?
  createdAt       DateTime       @default(now())
  allocatedAt     DateTime?
  allocationStatus AllocationStatus @default(PENDING)
  
  User            User?          @relation("RevenueFromUser", fields: [userId], references: [id])
  ProfitPoolConfigVersion ProfitPoolConfigVersion? @relation(fields: [profitPoolConfigVersionId], references: [id])
  Allocations     RevenueAllocation[]
  AdminActions    RevenueAdminAction[]

  @@index([source])
  @@index([sourceKey])
  @@index([userId])
  @@index([allocationStatus])
  @@index([createdAt])
  @@index([userId, source, createdAt])
  @@index([productId, createdAt])
  @@index([orderId])
  @@index([packageId, createdAt])
  @@index([country, state, createdAt])
  @@index([allocationStatus, createdAt])
  @@index([sourceId])
  @@index([profitPoolConfigVersionId])
  @@unique([source, sourceId])
}

model ProfitPoolConfigVersion {
  id               String   @id @default(cuid())
  version          Int      @unique
  isActive         Boolean  @default(false)
  companyPercent   Decimal  @db.Decimal(5, 2) @default(50.00)
  executivePercent Decimal  @db.Decimal(5, 2) @default(30.00)
  strategicPercent Decimal  @db.Decimal(5, 2) @default(20.00)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  revenueTransactions RevenueTransaction[]

  @@index([isActive, version])
}

model RevenueAllocation {
  id                    String            @id @default(cuid())
  revenueTransactionId  String
  destinationType       String            // "COMPANY_RESERVE" | "EXECUTIVE_POOL" | "STRATEGIC_POOL"
  destinationId         String?           // Pool ID for strategic pools
  amount                Decimal           @db.Decimal(18, 2)
  percentage            Decimal           @db.Decimal(5, 2) // e.g., 50.00 for 50%
  status                AllocationStatus  @default(ALLOCATED)
  createdAt             DateTime          @default(now())
  distributedAt         DateTime?

  RevenueTransaction    RevenueTransaction @relation(fields: [revenueTransactionId], references: [id], onDelete: Cascade)
  ExecutiveDistributions ExecutiveDistribution[]
  PoolDistributions      PoolDistribution[]

  @@index([revenueTransactionId])
  @@index([destinationType])
  @@index([status])
  @@index([destinationType, status, createdAt])
}

model ExecutiveShareholder {
  id              String          @id @default(cuid())
  role            String          @unique
  userId          String?         @unique
  percentage      Decimal         @db.Decimal(5, 2) // % of executive pool (30% total)
  isActive        Boolean         @default(true)
  totalEarned     Decimal         @db.Decimal(18, 2) @default(0) // Lifetime total earned
  currentBalance  Decimal         @db.Decimal(18, 2) @default(0) // Available wallet balance
  lastDistributionAt DateTime?    // Last time they received distribution
  assignedAt      DateTime?
  assignedBy      String?         // Admin user ID
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  User            User?           @relation("ExecutiveShareholderUser", fields: [userId], references: [id])
  AssignedByUser  User?           @relation("ExecutiveAssignedBy", fields: [assignedBy], references: [id])
  Distributions   ExecutiveDistribution[]
  WalletTransactions ExecutiveWalletTransaction[]

  @@index([userId])
  @@index([role])
  @@index([isActive])
}

model ExecutiveDistribution {
  id                    String              @id @default(cuid())
  allocationId          String
  shareholderId         String
  amount                Decimal             @db.Decimal(18, 2)
  percentage            Decimal             @db.Decimal(5, 2)
  status                DistributionStatus  @default(PENDING)
  distributedAt         DateTime?
  createdAt             DateTime            @default(now())
  
  Allocation            RevenueAllocation   @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  Shareholder           ExecutiveShareholder @relation(fields: [shareholderId], references: [id], onDelete: Cascade)
  WalletTransactions    ExecutiveWalletTransaction[]

  @@index([allocationId])
  @@index([shareholderId])
  @@index([status])
  @@index([distributedAt])
  @@index([shareholderId, status, distributedAt])
}

model ExecutiveWalletTransaction {
  id              String   @id @default(cuid())
  shareholderId   String
  amount          Decimal  @db.Decimal(18, 2)
  type            WalletTransactionType // "DISTRIBUTION" | "WITHDRAWAL" | "ADJUSTMENT"
  distributionId  String?
  description     String?
  metadata        Json?
  createdAt       DateTime @default(now())
  
  Shareholder     ExecutiveShareholder @relation(fields: [shareholderId], references: [id], onDelete: Cascade)
  Distribution    ExecutiveDistribution? @relation(fields: [distributionId], references: [id])
  
  @@index([shareholderId])
  @@index([type])
  @@index([createdAt])
  @@index([shareholderId, createdAt])
}

model StrategyPool {
  id                   String               @id @default(cuid())
  type                 PoolType             @unique
  name                 String
  description          String?
  percentage           Decimal              @db.Decimal(5, 2) @default(4.00) // 4% each (configurable)
  balance              Decimal              @db.Decimal(18, 2) @default(0) // Current pool balance
  isActive             Boolean              @default(true)
  // Distribution scheduling
  distributionFrequency DistributionFrequency @default(MANUAL) // How often to distribute
  lastDistributedAt    DateTime?            // When last distribution was executed
  nextDistributionAt   DateTime?            // When next distribution is due (computed/set by admin)
  // Leadership pool cap
  maxMembers           Int?                 // Max beneficiaries (null = unlimited; 1000 for LEADERSHIP)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  Members              PoolMember[]
  Distributions        PoolDistribution[]
  AdminActions         PoolAdminAction[]
  TechProjects         TechPoolProject[]

  @@index([type])
  @@index([isActive])
  @@index([distributionFrequency])
}

model PoolMember {
  id                   String          @id @default(cuid())
  poolId               String
  userId               String
  customPercentage     Decimal?        @db.Decimal(5, 2) // If null, split equally
  isActive             Boolean         @default(true)
  totalEarned          Decimal         @db.Decimal(18, 2) @default(0) // Lifetime total earned from this pool
  currentBalance       Decimal         @db.Decimal(18, 2) @default(0) // Available wallet balance from this pool
  lastDistributionAt   DateTime?       // Last distribution received
  joinedAt             DateTime        @default(now())
  addedBy              String          // Admin user ID
  leftAt               DateTime?
  // Eligibility & governance
  eligibilityCriteria  String?         // Human-readable criteria used to qualify member (e.g. "Min ₦500K investment, 12-month lock-up")
  qualificationNote    String?         // Admin note at time of addition
  qualificationStatus  String?         // e.g. "ACTIVE", "PENDING_REVIEW", "SUSPENDED"
  
  Pool            StrategyPool    @relation(fields: [poolId], references: [id], onDelete: Cascade)
  User            User            @relation("PoolMemberUser", fields: [userId], references: [id])
  AddedByUser     User            @relation("PoolMemberAddedBy", fields: [addedBy], references: [id])

  @@unique([poolId, userId])
  @@index([poolId])
  @@index([userId])
  @@index([isActive])
}

model PoolDistribution {
  id                    String              @id @default(cuid())
  allocationId          String
  poolId                String
  totalAmount           Decimal             @db.Decimal(18, 2)
  memberCount           Int
  amountPerMember       Decimal             @db.Decimal(18, 2)
  status                DistributionStatus  @default(PENDING)
  distributedAt         DateTime?
  distributedBy         String?             // Admin user ID
  createdAt             DateTime            @default(now())
  
  Allocation            RevenueAllocation   @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  Pool                  StrategyPool        @relation(fields: [poolId], references: [id], onDelete: Cascade)
  DistributedByUser     User?               @relation("PoolDistributedBy", fields: [distributedBy], references: [id])

  @@index([allocationId])
  @@index([poolId])
  @@index([status])
  @@index([distributedAt])
}

model CompanyReserve {
  id              String          @id @default(cuid())
  balance         Decimal         @db.Decimal(18, 2) @default(0)
  totalReceived   Decimal         @db.Decimal(18, 2) @default(0)
  totalSpent      Decimal         @db.Decimal(18, 2) @default(0)
  currency        String          @default("NGN")
  updatedAt       DateTime        @updatedAt
  createdAt       DateTime        @default(now())
  
  Transactions    CompanyReserveTransaction[]
}

model CompanyReserveTransaction {
  id          String   @id @default(cuid())
  reserveId   String
  amount      Decimal  @db.Decimal(18, 2)
  type        ReserveTransactionType // "REVENUE_ALLOCATION" | "OPERATIONAL_SPEND" | "ADJUSTMENT"
  category    String?  // "SALARIES" | "INFRASTRUCTURE" | "MARKETING" | "LEGAL" | "OTHER"
  description String
  approvedBy  String   // Admin user ID
  metadata    Json?
  createdAt   DateTime @default(now())
  
  Reserve     CompanyReserve @relation(fields: [reserveId], references: [id], onDelete: Cascade)
  ApprovedBy  User @relation("CompanyReserveApprovals", fields: [approvedBy], references: [id])
  
  @@index([reserveId])
  @@index([type])
  @@index([category])
  @@index([createdAt])
  @@index([reserveId, type, createdAt])
}

enum ReserveTransactionType {
  REVENUE_ALLOCATION
  OPERATIONAL_SPEND
  TRANSFER_TO_POOL
  TRANSFER_FROM_POOL
  ADJUSTMENT
  BONUS
}

model RevenueAdminAction {
  id                    String          @id @default(cuid())
  adminId               String
  actionType            String          // "ALLOCATION_RUN" | "DISTRIBUTION_RUN" | "POOL_EDIT" | etc
  description           String
  revenueTransactionId  String?
  metadata              Json?
  createdAt             DateTime        @default(now())

  Admin                 User            @relation("RevenueAdminActions", fields: [adminId], references: [id])
  RevenueTransaction    RevenueTransaction? @relation(fields: [revenueTransactionId], references: [id])

  @@index([adminId])
  @@index([actionType])
  @@index([createdAt])
}

model PoolAdminAction {
  id              String          @id @default(cuid())
  poolId          String
  adminId         String
  actionType      String          // "MEMBER_ADDED" | "MEMBER_REMOVED" | "PERCENTAGE_CHANGED" | etc
  description     String
  metadata        Json?
  createdAt       DateTime        @default(now())

  Pool            StrategyPool    @relation(fields: [poolId], references: [id], onDelete: Cascade)
  Admin           User            @relation("PoolAdminActions", fields: [adminId], references: [id])

  @@index([poolId])
  @@index([adminId])
  @@index([createdAt])
}

// Technology Pool project budget tracking
model TechPoolProject {
  id              String          @id @default(cuid())
  poolId          String          // References StrategyPool TECHNOLOGY
  title           String
  description     String?
  category        String?         // "PRODUCT_DEV" | "INFRASTRUCTURE" | "SECURITY" | "R_AND_D" | "TOOLING" | "OTHER"
  approvedBudget  Decimal         @db.Decimal(18, 2) // Approved budget in NGN
  totalSpent      Decimal         @db.Decimal(18, 2) @default(0) // Running total spent
  status          TechProjectStatus @default(PROPOSED)
  proposedBy      String          // Admin user ID
  approvedBy      String?         // Admin user ID (null until approved)
  approvedAt      DateTime?
  startDate       DateTime?
  endDate         DateTime?
  milestones      String?         // JSON array of milestone strings
  roiNotes        String?         // Admin-entered ROI / outcome notes
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  Pool            StrategyPool    @relation(fields: [poolId], references: [id], onDelete: Cascade)
  ProposedBy      User            @relation("TechProjectProposed", fields: [proposedBy], references: [id])
  ApprovedBy      User?           @relation("TechProjectApproved", fields: [approvedBy], references: [id])
  Spends          TechPoolSpend[]

  @@index([poolId])
  @@index([status])
  @@index([proposedBy])
}

model TechPoolSpend {
  id          String          @id @default(cuid())
  projectId   String
  amount      Decimal         @db.Decimal(18, 2)
  description String
  spentBy     String          // Admin user ID
  receipt     String?         // URL or reference to receipt/invoice
  createdAt   DateTime        @default(now())

  Project     TechPoolProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  SpentBy     User            @relation("TechPoolSpendUser", fields: [spentBy], references: [id])

  @@index([projectId])
  @@index([createdAt])
}

enum TechProjectStatus {
  PROPOSED
  APPROVED
  IN_PROGRESS
  COMPLETED
  REJECTED
  ON_HOLD
}

// Monthly snapshot for historical tracking
model RevenueSnapshot {
  id                        String   @id @default(cuid())
  month                     Int      // 1-12
  year                      Int      // 2024, 2025, etc
  
  // Total Revenue
  totalRevenue              Decimal  @default(0)
  
  // Allocation Totals (50/30/20)
  companyReserveTotal       Decimal  @default(0)
  executivePoolTotal        Decimal  @default(0)
  strategicPoolsTotal       Decimal  @default(0)
  
  // Revenue by Source Breakdown
  communitySupport          Decimal  @default(0)
  membershipRegistration    Decimal  @default(0)
  membershipRenewal         Decimal  @default(0)
  storePurchase             Decimal  @default(0)
  withdrawalFee             Decimal  @default(0)
  youtubeSubscription       Decimal  @default(0)
  thirdPartyServices        Decimal  @default(0)
  palliativeProgram         Decimal  @default(0)
  leadershipPoolFee         Decimal  @default(0)
  trainingCenter            Decimal  @default(0)
  other                     Decimal  @default(0)
  
  // Distribution Stats
  executivesDistributed     Decimal  @default(0)
  poolsDistributed          Decimal  @default(0)
  transactionCount          Int      @default(0)
  
  // Snapshot Metadata
  createdAt                 DateTime @default(now())
  createdBy                 String?
  
  @@unique([month, year])
  @@index([year, month])
}

// ============================================
// ELITE CLUB SYSTEM
// ============================================

enum EliteClubTier {
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

enum EliteClubFormationStatus {
  OPEN
  PAUSED
  CLOSED
}

enum EliteClubStatus {
  FORMING
  ACTIVE
  SUSPENDED
  DISSOLVED
}

enum EliteClubMemberStatus {
  ACTIVE
  DEFAULTED
  SUSPENDED
  OPTED_OUT
  REPLACED
}

enum EliteClubAppStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum EliteClubDocType {
  BANK_STATEMENT
  BUSINESS_PROOF
  TRAVEL_PROOF
  PROPERTY_PROOF
  CONTRIBUTION_DECLARATION
}

enum EliteClubContribStatus {
  PAID
  PENDING
  MISSED
  PARTIAL
}

enum EliteClubPayoutStatus {
  PENDING
  PAID
  BLOCKED
}

enum EliteClubSwapStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum EliteClubInvestmentCategory {
  DIGITAL_WEB3
  OFFLINE
}

enum EliteClubInvestmentStatus {
  DRAFT
  UNDER_REVIEW
  VOTED
  APPROVED
  FUNDED
  ACTIVE
  COMPLETED
  REJECTED
}

enum EliteClubVoteChoice {
  ACCEPT
  REJECT
  ABSTAIN
}

enum EliteClubCredEventType {
  CONTRIBUTION_PAID
  CONTRIBUTION_MISSED
  DEFAULT
  SUSPENSION
  OPT_OUT
  PAYOUT_RECEIVED
  GUARANTEE_DEFAULT
  POSITIVE_VOTE
  ADMIN_ADJUSTMENT
}

enum EliteClubTokenVerifMethod {
  WALLET_CONNECT
  PROOF_UPLOAD
}

// Core club entity
model EliteClub {
  id              String                   @id @default(cuid())
  name            String
  tier            EliteClubTier
  status          EliteClubStatus          @default(FORMING)
  formationStatus EliteClubFormationStatus @default(OPEN)
  membersCount    Int                      @default(0)
  activatedAt     DateTime?
  dissolvedAt     DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  members         EliteClubMember[]
  applications    EliteClubApplication[]
  contributions   EliteClubContribution[]
  payouts         EliteClubEmpowermentPayout[]
  swapRequests    EliteClubSwapRequest[]
  investmentPools EliteClubInvestmentPool[]
  investments     EliteClubInvestment[]
  opsFees         EliteClubOperationsFee[]

  @@index([tier, status])
}

// Candidate application
model EliteClubApplication {
  id               String             @id @default(cuid())
  userId           String
  clubId           String?
  tier             EliteClubTier
  status           EliteClubAppStatus @default(PENDING)
  bptVerified      Boolean            @default(false)
  pacTokenVerified Boolean            @default(false)
  submittedAt      DateTime           @default(now())
  reviewedAt       DateTime?
  reviewedBy       String?
  rejectionReason  String?
  notes            String?
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  club             EliteClub?         @relation(fields: [clubId], references: [id], onDelete: SetNull)
  documents        EliteClubDocument[]
  tokenHoldings    EliteClubTokenHolding[]

  @@index([userId, status])
  @@index([clubId])
  @@index([tier, status])
}

// Uploaded application documents
model EliteClubDocument {
  id            String           @id @default(cuid())
  applicationId String
  docType       EliteClubDocType
  fileUrl       String
  uploadedAt    DateTime         @default(now())
  verifiedAt    DateTime?
  verifiedBy    String?
  rejected      Boolean          @default(false)
  rejectReason  String?
  application   EliteClubApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// Token holding verification (BPT + PACToken)
model EliteClubTokenHolding {
  id                  String                    @id @default(cuid())
  userId              String
  applicationId       String?
  tier                EliteClubTier
  bptAmount           Decimal                   @default(0) @db.Decimal(20, 8)
  pacTokenAmount      Decimal                   @default(0) @db.Decimal(20, 8)
  verifiedAt          DateTime?
  verificationMethod  EliteClubTokenVerifMethod @default(PROOF_UPLOAD)
  proofUrl            String?
  walletAddress       String?
  adminApproved       Boolean                   @default(false)
  adminApprovedBy     String?
  createdAt           DateTime                  @default(now())
  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  application         EliteClubApplication?     @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([applicationId])
}

// Active club member
model EliteClubMember {
  id                   String                @id @default(cuid())
  userId               String
  clubId               String
  rotationNumber       Int                   // 1–11
  status               EliteClubMemberStatus @default(ACTIVE)
  credibilityScore     Decimal               @default(5) @db.Decimal(5, 2)
  totalContributed     Decimal               @default(0)
  empowermentReceived  Boolean               @default(false)
  empowermentPending   Boolean               @default(false)
  defaultCount         Int                   @default(0)
  joinedAt             DateTime              @default(now())
  suspendedAt          DateTime?
  replacedAt           DateTime?
  legalFlaggedAt       DateTime?
  updatedAt            DateTime              @updatedAt
  user                 User                  @relation("EliteClubMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  club                 EliteClub             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  contributions        EliteClubContribution[]
  payouts              EliteClubEmpowermentPayout[]
  swapRequestsFrom     EliteClubSwapRequest[]       @relation("SwapRequester")
  swapRequestsTo       EliteClubSwapRequest[]       @relation("SwapTarget")
  credibilityEvents    EliteClubCredibilityEvent[]
  guarantorRecords     EliteClubGuarantor[]
  votes                EliteClubVote[]
  legalEvents          EliteClubLegalEvent[]
  opsFees              EliteClubOperationsFee[]

  @@unique([clubId, rotationNumber])
  @@unique([userId, clubId])
  @@index([clubId, status])
  @@index([userId])
}

// Monthly contribution ledger
model EliteClubContribution {
  id                String                 @id @default(cuid())
  memberId          String
  clubId            String
  userId            String
  month             Int
  year              Int
  totalAmount       Decimal
  empowermentShare  Decimal
  investmentShare   Decimal
  status            EliteClubContribStatus @default(PENDING)
  paidAt            DateTime?
  dueAt             DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  member            EliteClubMember        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  club              EliteClub              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  opsFee            EliteClubOperationsFee?

  @@unique([memberId, month, year])
  @@index([clubId, month, year])
  @@index([status])
}

// Operations fee split record per contribution
model EliteClubOperationsFee {
  id             String   @id @default(cuid())
  clubId         String
  memberId       String
  contributionId String   @unique
  month          Int
  year           Int
  grossOps       Float
  bpiShare       Float
  eliteShare     Float
  createdAt      DateTime @default(now())

  club         EliteClub             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  member       EliteClubMember       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  contribution EliteClubContribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@index([memberId])
}

// Empowerment rotation payout
model EliteClubEmpowermentPayout {
  id               String                @id @default(cuid())
  clubId           String
  memberId         String
  rotationNumber   Int
  amount           Decimal
  scheduledMonth   Int
  scheduledYear    Int
  status           EliteClubPayoutStatus @default(PENDING)
  paidAt           DateTime?
  blockedReason    String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  club             EliteClub             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  member           EliteClubMember       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([clubId, scheduledMonth, scheduledYear])
  @@index([clubId])
  @@index([memberId])
  @@index([status])
}

// Rotation number swap request
model EliteClubSwapRequest {
  id             String              @id @default(cuid())
  clubId         String
  requesterId    String
  targetId       String
  fromRotation   Int
  toRotation     Int
  status         EliteClubSwapStatus @default(PENDING)
  requestedAt    DateTime            @default(now())
  resolvedAt     DateTime?
  resolvedBy     String?
  club           EliteClub           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  requester      EliteClubMember     @relation("SwapRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  target         EliteClubMember     @relation("SwapTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@index([requesterId])
  @@index([targetId])
  @@index([status])
}

// Investment pool balance per club per month
model EliteClubInvestmentPool {
  id               String    @id @default(cuid())
  clubId           String
  month            Int
  year             Int
  grossAmount      Decimal   @default(0)
  netAmount        Decimal   @default(0)
  opsFeeBpi        Decimal   @default(0)
  opsFeeElite      Decimal   @default(0)
  digitalBalance   Decimal   @default(0)
  offlineBalance   Decimal   @default(0)
  available        Decimal   @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  club             EliteClub @relation(fields: [clubId], references: [id], onDelete: Cascade)
  investments      EliteClubInvestment[]

  @@unique([clubId, month, year])
  @@index([clubId])
}

// Investment record
model EliteClubInvestment {
  id                     String                      @id @default(cuid())
  clubId                 String
  poolId                 String
  recommendedBy          String
  title                  String
  description            String
  category               EliteClubInvestmentCategory
  amountRequested        Decimal
  expectedReturn         Decimal?
  durationMonths         Int?
  riskNotes              String?
  bpiProfitShareEnabled  Boolean                     @default(false)
  bpiProfitSharePct      Decimal                     @default(0) @db.Decimal(5, 2)
  status                 EliteClubInvestmentStatus   @default(DRAFT)
  legalReviewUrl         String?
  legalReviewedAt        DateTime?
  legalReviewedBy        String?
  proofOfDepositUrl      String?
  proofUploadedAt        DateTime?
  proofUploadedBy        String?
  approvedAt             DateTime?
  fundedAt               DateTime?
  completedAt            DateTime?
  actualReturn           Decimal?
  bpiProfitShareAmount   Decimal?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  club                   EliteClub                   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  pool                   EliteClubInvestmentPool     @relation(fields: [poolId], references: [id])
  votes                  EliteClubVote[]
  guarantors             EliteClubGuarantor[]

  @@index([clubId, status])
  @@index([poolId])
}

// Member vote on investment
model EliteClubVote {
  id           String              @id @default(cuid())
  investmentId String
  memberId     String
  userId       String
  vote         EliteClubVoteChoice
  comment      String?
  votedAt      DateTime            @default(now())
  investment   EliteClubInvestment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  member       EliteClubMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([investmentId, memberId])
  @@index([investmentId])
  @@index([memberId])
}

// Credibility score change audit log
model EliteClubCredibilityEvent {
  id         String                 @id @default(cuid())
  memberId   String
  event      EliteClubCredEventType
  delta      Decimal                @db.Decimal(5, 2)
  scoreBefore Decimal               @db.Decimal(5, 2)
  scoreAfter  Decimal               @db.Decimal(5, 2)
  reason     String?
  referenceId String?               // investmentId, contributionId, etc.
  createdAt  DateTime               @default(now())
  member     EliteClubMember        @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([event])
}

// Guarantor assignment per investment
model EliteClubGuarantor {
  id           String              @id @default(cuid())
  memberId     String
  userId       String
  investmentId String
  level        Int                 // 1, 2, 3, 4
  qualifiedAt  DateTime            @default(now())
  isActive     Boolean             @default(true)
  member       EliteClubMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  investment   EliteClubInvestment @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([investmentId])
}

// Legal event / suspension flag
model EliteClubLegalEvent {
  id         String          @id @default(cuid())
  memberId   String
  eventType  String          // DEFAULT, SUSPENSION, LEGAL_ACTION
  notes      String?
  moustRef   String?
  raisedBy   String?
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime        @default(now())
  member     EliteClubMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

// ============================================================
// BPI TECHQUIZ COMPETITION — MODELS
// ============================================================

// ---- Enums ----

enum TechQuizEventStatus {
  DRAFT
  APPROVED
  PUBLISHED
  COMPLETED
  ARCHIVED
}

enum TechQuizSchoolStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum TechQuizParticipationStatus {
  APPROVED
  ELIGIBLE
  NOT_ELIGIBLE
  CLOSED
}

enum TechQuizChildStatus {
  INACTIVE
  TECH_QUIZ_ENABLED
  ACTIVE
}

enum TechQuizApplicationStatus {
  APPLIED
  SLOT_RESERVED
  VERIFIED
  REJECTED
  ROUND1_ELIGIBLE
  QUALIFIER
  ROUND2_ELIGIBLE
}

enum TechQuizPaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum TechQuizCBTRound {
  ROUND1
  ROUND2
}

enum TechQuizCBTSessionStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  SCORED
}

enum TechQuizSponsorType {
  CHILD_PARENT
  SCHOOL_COHORT
  PRIZE_POOL
}

enum TechQuizAllocationPool {
  SCHOOL_POOL
  EVENT_PRIZE_POOL
}

// ---- Core Event Model ----

model TechQuizEvent {
  id                       String               @id @default(cuid())
  title                    String
  state                    String
  status                   TechQuizEventStatus  @default(DRAFT)
  frequencyType            String?              // MONTHLY, QUARTERLY, BIANNUAL, ANNUAL — informational tag
  applicationWindowStart   DateTime?
  applicationWindowEnd     DateTime?
  sponsorshipPackagePrice  Decimal              @default(18000) @db.Decimal(12, 2)
  topQualifiersPerSchool   Int                  @default(4)
  cbtWeightPct             Int                  @default(55)    // must sum to 100 with onsiteWeightPct
  onsiteWeightPct          Int                  @default(45)
  isZonalOrNational        Boolean              @default(false)
  zonalEventType           String?              // ZONAL, NATIONAL
  publishedAt              DateTime?
  completedAt              DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  createdBy                String?

  round1Schedules          TechQuizRound1Schedule[]
  round2Schedules          TechQuizRound2Schedule[]
  awardBrackets            TechQuizAwardBracket[]
  scoringRubric            TechQuizScoringRubric?
  eventSchools             TechQuizEventSchool[]
  applications             TechQuizApplication[]
  qualifiers               TechQuizQualifier[]
  results                  TechQuizResult[]
  cbtSessions              TechQuizCBTSession[]
  onsiteScores             TechQuizOnsiteScore[]
  sponsorshipPackages      TechQuizSponsorshipPackage[]
  auditLogs                TechQuizAuditLog[]
  legalEvents              TechQuizLegalEvent[]

  @@index([state])
  @@index([status])
}

// Round 1 schedule (per event — may have multiple venues)
model TechQuizRound1Schedule {
  id               String         @id @default(cuid())
  eventId          String
  venueDescription String?
  cbtWindowStart   DateTime?
  cbtWindowEnd     DateTime?
  materialReleaseAt DateTime?
  notes            String?
  createdAt        DateTime       @default(now())
  event            TechQuizEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// Round 2 schedule (per event)
model TechQuizRound2Schedule {
  id               String         @id @default(cuid())
  eventId          String
  venueDescription String?
  cbtWindowStart   DateTime?
  cbtWindowEnd     DateTime?
  onsiteDate       DateTime?
  notes            String?
  createdAt        DateTime       @default(now())
  event            TechQuizEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// Award brackets per event (e.g. 1–3 = Major, 4–10 = Merit, 11–20 = Consolation)
model TechQuizAwardBracket {
  id               String         @id @default(cuid())
  eventId          String
  minRank          Int
  maxRank          Int
  bracketLabel     String         // "Major", "Merit", "Consolation"
  awardDescription String?
  bpiActivationGranted Boolean    @default(true)
  createdAt        DateTime       @default(now())
  event            TechQuizEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// Onsite scoring rubric (one per event)
model TechQuizScoringRubric {
  id                    String        @id @default(cuid())
  eventId               String        @unique
  maxPresentation       Int           @default(40)
  maxLogicalReasoning   Int           @default(30)
  maxUseCase            Int           @default(30)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  event                 TechQuizEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// ---- School Models ----

// BPI-approved school entity
model TechQuizSchool {
  id             String                @id @default(cuid())
  name           String
  state          String
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  mouSigned      Boolean               @default(false)
  mouSignedAt    DateTime?
  status         TechQuizSchoolStatus  @default(PENDING)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  adminProfiles  SchoolAdminProfile[]
  eventSchools   TechQuizEventSchool[]
  applications   TechQuizApplication[]
  childProfiles  TechQuizChildProfile[]
  childBeneficiaries TechQuizChildBeneficiary[]
  sponsorships   TechQuizSponsorshipPackage[]

  @@index([state])
  @@index([status])
}

// Junction: which schools participate in which events + quota settings
model TechQuizEventSchool {
  id                  String                      @id @default(cuid())
  eventId             String
  schoolId            String
  minStudents         Int                         @default(10)
  maxStudents         Int                         @default(12)
  participationStatus TechQuizParticipationStatus @default(APPROVED)
  enrolledCount       Int                         @default(0)
  approvedAt          DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  event               TechQuizEvent               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  school              TechQuizSchool              @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([eventId, schoolId])
  @@index([eventId])
  @@index([schoolId])
}

// Lightweight school admin profile linked to a BPI user
model SchoolAdminProfile {
  id        String         @id @default(cuid())
  userId    String         @unique
  schoolId  String
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  school    TechQuizSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

// ---- Parent / Child Models ----

// Child beneficiary record created by parent
model TechQuizChildBeneficiary {
  id                   String              @id @default(cuid())
  parentUserId         String
  childName            String
  dateOfBirth          DateTime?
  email                String?
  schoolId             String?
  state                String?
  parentalConsentGiven Boolean             @default(false)
  parentalConsentAt    DateTime?
  status               TechQuizChildStatus @default(INACTIVE)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  parent               User                @relation(fields: [parentUserId], references: [id], onDelete: Cascade)
  school               TechQuizSchool?     @relation(fields: [schoolId], references: [id])
  childProfiles        TechQuizChildProfile[]
  applications         TechQuizApplication[]
  consentLogs          TechQuizConsentLog[]
  results              TechQuizResult[]

  @@index([parentUserId])
  @@index([schoolId])
  @@index([status])
}

// Child TechQuiz profile mapping (state + school, per child)
model TechQuizChildProfile {
  id                  String                   @id @default(cuid())
  childBeneficiaryId  String
  state               String
  schoolId            String
  createdAt           DateTime                 @default(now())
  childBeneficiary    TechQuizChildBeneficiary @relation(fields: [childBeneficiaryId], references: [id], onDelete: Cascade)
  school              TechQuizSchool           @relation(fields: [schoolId], references: [id])

  @@index([childBeneficiaryId])
  @@index([schoolId])
}

// ---- Application Model ----

model TechQuizApplication {
  id                 String                    @id @default(cuid())
  parentUserId       String
  childBeneficiaryId String
  eventId            String
  schoolId           String
  state              String
  paymentReference   String?
  paymentStatus      TechQuizPaymentStatus     @default(PENDING)
  status             TechQuizApplicationStatus @default(APPLIED)
  rejectionReason    String?
  verifiedAt         DateTime?
  verifiedBy         String?
  appliedAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  parent             User                     @relation("TechQuizApplicationParent", fields: [parentUserId], references: [id], onDelete: Cascade)
  childBeneficiary   TechQuizChildBeneficiary @relation(fields: [childBeneficiaryId], references: [id], onDelete: Cascade)
  event              TechQuizEvent            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  school             TechQuizSchool           @relation(fields: [schoolId], references: [id])
  cbtSessions        TechQuizCBTSession[]
  onsiteScore        TechQuizOnsiteScore?
  result             TechQuizResult?
  qualifier          TechQuizQualifier?

  @@unique([childBeneficiaryId, eventId])
  @@index([parentUserId])
  @@index([eventId])
  @@index([schoolId])
  @@index([status])
}

// ---- CBT & Scoring Models ----

// CBT session per child per round
model TechQuizCBTSession {
  id             String                  @id @default(cuid())
  applicationId  String
  eventId        String
  round          TechQuizCBTRound
  startedAt      DateTime?
  submittedAt    DateTime?
  score          Decimal?                @db.Decimal(8, 2)
  totalQuestions Int?
  status         TechQuizCBTSessionStatus @default(NOT_STARTED)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  application    TechQuizApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  event          TechQuizEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([applicationId, round])
  @@index([applicationId])
  @@index([eventId])
  @@index([round])
}

// Onsite assessment scores (presentation, logical reasoning, use-case)
model TechQuizOnsiteScore {
  id                    String              @id @default(cuid())
  applicationId         String              @unique
  eventId               String
  assessorUserId        String
  presentationScore     Decimal             @default(0) @db.Decimal(8, 2)
  logicalReasoningScore Decimal             @default(0) @db.Decimal(8, 2)
  useCaseScore          Decimal             @default(0) @db.Decimal(8, 2)
  totalOnsiteScore      Decimal             @default(0) @db.Decimal(8, 2)
  notes                 String?
  scoredAt              DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  isLocked              Boolean             @default(false)

  application           TechQuizApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  event                 TechQuizEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assessor              User                @relation("TechQuizOnsiteScoreAssessor", fields: [assessorUserId], references: [id])

  @@index([eventId])
  @@index([assessorUserId])
}

// ---- Results & Ranking Models ----

// Per-student results record (all scores + final rank)
model TechQuizResult {
  id                 String               @id @default(cuid())
  applicationId      String               @unique
  childBeneficiaryId String
  eventId            String
  round1Score        Decimal?             @db.Decimal(8, 2)
  intraSchoolRank    Int?
  round2CbtScore     Decimal?             @db.Decimal(8, 2)
  onsiteScore        Decimal?             @db.Decimal(8, 2)
  finalScore         Decimal?             @db.Decimal(8, 2)
  finalRank          Int?
  awardBracket       String?              // "Major", "Merit", "Consolation"
  round1Published    Boolean              @default(false)
  finalPublished     Boolean              @default(false)
  bpiActivationGranted Boolean            @default(false)
  bpiActivationGrantedAt DateTime?
  computedAt         DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  application        TechQuizApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  childBeneficiary   TechQuizChildBeneficiary @relation(fields: [childBeneficiaryId], references: [id], onDelete: Cascade)
  event              TechQuizEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([finalRank])
  @@index([childBeneficiaryId])
}

// Qualifier record (top-N per school post Round 1)
model TechQuizQualifier {
  id            String              @id @default(cuid())
  applicationId String              @unique
  eventId       String
  schoolId      String
  round1Rank    Int
  qualifiedAt   DateTime            @default(now())

  application   TechQuizApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  event         TechQuizEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([schoolId])
}

// ---- Sponsorship Models ----

// Sponsor entity (BPI member or external)
model TechQuizSponsor {
  id        String                     @id @default(cuid())
  userId    String?                    // optional: linked to BPI user
  name      String
  email     String?
  phone     String?
  status    String                     @default("ACTIVE")
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  user      User?                      @relation("TechQuizSponsorUser", fields: [userId], references: [id])
  packages  TechQuizSponsorshipPackage[]

  @@index([userId])
}

// Sponsorship package (per sponsor per event)
model TechQuizSponsorshipPackage {
  id               String                 @id @default(cuid())
  sponsorId        String
  eventId          String
  sponsorType      TechQuizSponsorType
  childrenCount    Int                    @default(1)
  schoolId         String?
  totalAmount      Decimal                @db.Decimal(12, 2)
  paymentReference String?
  paymentStatus    TechQuizPaymentStatus  @default(PENDING)
  allocationPool   TechQuizAllocationPool @default(EVENT_PRIZE_POOL)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  sponsor          TechQuizSponsor        @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  event            TechQuizEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  school           TechQuizSchool?        @relation(fields: [schoolId], references: [id])

  @@index([sponsorId])
  @@index([eventId])
  @@index([schoolId])
}

// ---- Compliance & Audit Models ----

// Parental consent log (versioned)
model TechQuizConsentLog {
  id                 String                   @id @default(cuid())
  parentUserId       String
  childBeneficiaryId String
  consentVersion     String                   @default("1.0")
  consentText        String?
  consentGivenAt     DateTime                 @default(now())
  ipAddress          String?

  parent             User                     @relation("TechQuizConsentParent", fields: [parentUserId], references: [id], onDelete: Cascade)
  childBeneficiary   TechQuizChildBeneficiary @relation(fields: [childBeneficiaryId], references: [id], onDelete: Cascade)

  @@index([parentUserId])
  @@index([childBeneficiaryId])
}

// Full audit trail for all critical TechQuiz actions
model TechQuizAuditLog {
  id          String         @id @default(cuid())
  actorId     String?
  actorRole   String?
  action      String
  entityType  String
  entityId    String?
  eventId     String?
  metadata    Json?
  createdAt   DateTime       @default(now())

  actor       User?          @relation("TechQuizAuditActor", fields: [actorId], references: [id])
  event       TechQuizEvent? @relation(fields: [eventId], references: [id])

  @@index([actorId])
  @@index([eventId])
  @@index([entityType])
  @@index([action])
}

// Legal / compliance events per event
model TechQuizLegalEvent {
  id          String         @id @default(cuid())
  eventId     String
  description String
  raisedBy    String?
  raisedAt    DateTime       @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?
  resolution  String?

  event       TechQuizEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// ─── KYC (Know Your Customer) ────────────────────────────────

model KycSubmission {
  id                  String    @id @default(cuid())
  userId              String
  status              String    @default("pending") // pending, under_review, approved, rejected, expired
  // Personal details
  legalFirstName      String
  legalLastName       String
  dateOfBirth         DateTime
  nationality         String
  gender              String?
  // Address
  residentialAddress  String
  residentialCity     String
  residentialState    String
  residentialCountry  String
  residentialZip      String?
  // Identity document
  documentType        String    // national_id, passport, drivers_license, voters_card
  documentNumber      String
  documentFrontUrl    String
  documentBackUrl     String?
  documentExpiryDate  DateTime?
  // Proof of address
  proofOfAddressUrl   String?
  proofOfAddressType  String?   // utility_bill, bank_statement, tax_document
  // Selfie / biometric
  selfieUrl           String?
  livenessCheckPassed Boolean   @default(false)
  // BVN / NIN (Nigerian identity numbers)
  bvn                 String?
  nin                 String?
  // Admin review
  reviewedBy          String?
  reviewedAt          DateTime?
  rejectionReason     String?
  adminNotes          String?
  // Expiry tracking
  expiresAt           DateTime?
  expiryNotifiedAt    DateTime?
  // Timestamps
  submittedAt         DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User      @relation("KycSubmissions", fields: [userId], references: [id], onDelete: Cascade)
  reviewer            User?     @relation("KycReviewer", fields: [reviewedBy], references: [id])
  auditLogs           KycAuditLog[]

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([submittedAt])
}

model KycAuditLog {
  id              String        @id @default(cuid())
  submissionId    String
  action          String        // submitted, under_review, approved, rejected, expired, resubmitted
  performedBy     String?
  performedByRole String?
  details         String?
  metadata        Json?
  createdAt       DateTime      @default(now())

  submission      KycSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([action])
}

// ── Newsletter Campaign Persistence ─────────────────────────────
model NewsletterCampaign {
  id                String   @id @default(cuid())
  jobId             String   @unique
  adminId           String
  status            String   @default("running") // running, completed, cancelled, error
  scheduledFor      DateTime?
  subject           String
  body              String   @db.Text
  filter            String   @default("all")
  membershipPackage String?
  fromEmail         String?
  replyToEmail      String?
  attachments       Json     @default("[]")
  embeddedImages    Json     @default("[]")

  // Send rate config
  batchSize         Int      @default(10)
  delayBetweenMs    Int      @default(4000)
  batchCooldownMs   Int      @default(45000)
  warmUp            Boolean  @default(true)

  // Stats
  totalRecipients   Int      @default(0)
  sentCount         Int      @default(0)
  failedCount       Int      @default(0)
  elapsedMs         Int      @default(0)
  lastError         String?

  // Per-email data (JSON arrays)
  sentEmails        Json     @default("[]")
  failedEmails      Json     @default("[]")
  errorLog          Json     @default("[]")
  sentRecipientIds  Json     @default("[]") // string[] of user IDs already sent
  allRecipientIds   Json     @default("[]") // string[] of all target user IDs

  startedAt         DateTime @default(now())
  completedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  admin             User     @relation("NewsletterCampaignAdmin", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([status])
  @@index([status, scheduledFor])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Promo Campaign System — revenue-isolated free membership activations
// ---------------------------------------------------------------------------

enum PromoCampaignType {
  FREE_MEMBERSHIP_ACTIVATION
}

model PromoCampaign {
  id               String            @id @default(cuid())
  name             String
  type             PromoCampaignType
  quota            Int
  usedCount        Int               @default(0)
  isActive         Boolean           @default(false)
  targetPackageId  String?
  startDate        DateTime?
  endDate          DateTime?
  notes            String?
  createdByAdminId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  Claims PromoActivationClaim[]

  @@index([isActive])
  @@index([createdAt])
}

model PromoActivationClaim {
  id         String   @id @default(cuid())
  userId     String   @unique
  campaignId String
  packageId  String
  claimedAt  DateTime @default(now())

  User     User          @relation("UserPromoActivationClaim", fields: [userId],  references: [id], onDelete: Cascade)
  Campaign PromoCampaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
  @@index([claimedAt])
}
