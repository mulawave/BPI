{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Revenue Anomaly Watch Settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspaceId",
    "alertThresholdPercent",
    "lookbackDays"
  ],
  "properties": {
    "workspaceId": {
      "type": "string",
      "title": "Workspace ID"
    },
    "alertThresholdPercent": {
      "type": "number",
      "title": "Alert Threshold (%)",
      "minimum": 0.5,
      "maximum": 25,
      "default": 4
    },
    "lookbackDays": {
      "type": "integer",
      "title": "Lookback Window (Days)",
      "minimum": 1,
      "maximum": 90,
      "default": 14
    },
    "includeWithdrawals": {
      "type": "boolean",
      "title": "Include Withdrawals",
      "default": true
    }
  }
}
